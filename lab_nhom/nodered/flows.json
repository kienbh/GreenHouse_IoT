.temp = num(p); n.status = 'online'; }\nelse if (sub === 'humidity' || sub === 'hum') { n.hum = num(p); n.status = 'online'; }\nelse if (sub === 'led') { n.led = bl(p); n.status = 'online'; }\nelse if (sub === 'button' || sub === 'btn') { n.btn = bl(p); n.status = 'online'; }\nelse { return null; }\nn.seen = Date.now();\ng[name] = n; flow.set('groups', g);\nconst rows = Object.values(g).sort((a,b)=>a.nhom.localeCompare(b.nhom)).map(x=>({\n  'Nhom': x.nhom, 'Trang thai': x.status,\n  'Nhiet do': x.temp==null?'--':x.temp, 'Do am': x.hum==null?'--':x.hum,\n  'LED': x.led==null?'--':(x.led?'BAT':'tat'), 'Nut': x.btn==null?'--':(x.btn?'nhan':'tha') }));\nconst isSel = (name === sel);\nreturn [\n  {payload: rows},\n  (n.temp!=null)?{topic:name, payload:n.temp}:null,\n  (n.hum!=null)?{topic:name, payload:n.hum}:null,\n  (isSel && n.temp!=null)?{payload:n.temp}:null,\n  (isSel && n.hum!=null)?{payload:n.hum}:null,\n  isSel?{payload:(n.led==null?'--':(n.led?'BAT':'tat'))}:null,\n  isSel?{payload:(n.btn==null?'--':(n.btn?'dang nhan':'tha'))}:null\n];\n","outputs":7,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":320,"y":200,"wires":[["tbl"],["chT"],["chH"],["gT"],["gH"],["txL"],["txB"]]},{"id":"tbl","type":"ui_table","z":"f1","group":"gov","name":"Bang nhom","order":1,"width":12,"height":6,"columns":[],"outputs":0,"cts":false,"x":560,"y":80,"wires":[]},{"id":"chT","type":"ui_chart","z":"f1","name":"Nhiet do","group":"gov","order":2,"width":6,"height":5,"label":"Nhiet do cac nhom (C)","chartType":"line","legend":"true","xformat":"HH:mm:ss","interpolate":"linear","nodata":"cho du lieu","dot":false,"ymin":"","ymax":"","removeOlder":"10","removeOlderPoints":"","removeOlderUnit":"60","cutout":0,"useOneColor":false,"useUTC":false,"colors":["#1f77b4","#ff7f0e","#2ca02c","#d62728","#9467bd","#8c564b","#e377c2","#17becf","#bcbd22","#7f7f7f","#aec7e8","#ffbb78"],"outputs":1,"useDifferentColor":false,"className":"","x":560,"y":160,"wires":[[]]},{"id":"chH","type":"ui_c