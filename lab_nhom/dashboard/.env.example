# Chép thành .env và sửa nếu broker không chạy trên chính máy này
MQTT_URL=mqtt://localhost:1883
# Cổng 1883 chỉ nhận client vô danh cho nhánh vju/iot/# (Bài 8: tài khoản nhà kính chỉ dùng cổng TLS 8883)
MQTT_USER=
MQTT_PASS=
MQTT_BASE=vju/iot
# Cổng giao diện web: http://localhost:3100 (app nhà kính dùng 3000)
PORT=3100
# Số nhóm hiện sẵn trên dashboard (nhom01..nhomNN), khớp mqtt_broker/tao_nhom.sh
GROUPS=12
