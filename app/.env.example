# Chép thành .env (start.sh tự chép). Mật khẩu thật do mqtt_broker/setup.sh tự điền vào .env, không sửa tay.
# Bài 8: MQTT qua TLS, xác minh broker bằng CA của nhóm (mqtt_broker/tls/ca.crt)
MQTT_URL=mqtts://localhost:8883
MQTT_USER=app
MQTT_PASS=DOI_MAT_KHAU
MQTT_BASE=vju/nhakinh
# Giao diện: HTTP chỉ trên máy này (http://localhost:3000); qua mạng LAN dùng HTTPS cổng 3443
PORT=3000
HTTPS_PORT=3443
# Bộ giả lập ESP32 (tools/sim_esp32.js) đăng nhập bằng tài khoản riêng của node sim-01
SIM_USER=sim-01
SIM_PASS=DOI_MAT_KHAU
SIM_DEVICE=sim-01
# Chế độ kiểm thử: hiện mật khẩu tài khoản mẫu trên trang đăng nhập khi mở từ CHÍNH MÁY NÀY. Đặt 0 trước khi demo/nộp.
SHOW_TEST_PASSWORDS=0
