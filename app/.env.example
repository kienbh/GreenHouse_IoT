# Chép thành .env và sửa nếu broker không chạy trên chính máy này
MQTT_URL=mqtt://localhost:1883
MQTT_USER=app
MQTT_PASS=apppass
MQTT_BASE=vju/nhakinh
# Cổng giao diện web: http://localhost:3000
PORT=3000
# Bộ giả lập ESP32 (tools/sim_esp32.js) đăng nhập bằng tài khoản của ESP32
SIM_USER=esp32
SIM_PASS=esp32pass
SIM_DEVICE=sim-01
